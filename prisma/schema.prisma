// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ParticipantSession {
  id              String   @id @default(uuid())
  group           String
  currentPhase    String   @default("INIT")

  // --- ABHÄNGIGE VARIABLEN ---
  // Phase 1: Soziale Adhärenz (H3) - Summenscore
  socialAdherence Int?

  // Phase 3: Verhaltens-Compliance (H1) - Binär (0 = Override, 1 = Befolgt)
  compliance      Int?

  // --- MDMT v2 (Trust Metriken - 8 Items) ---
  mReliable       Int?
  mCapable        Int?
  mCompetent      Int?
  mMeticulous     Int?

  mEthical        Int?
  mRespectable    Int?
  mSincere        Int?
  mBenevolent     Int?

  performanceTrust Float?
  moralTrust       Float?

  // --- MANIPULATION CHECK ---
  perceivedHumanlikeness Int?

  // --- DEMOGRAPHIE & KONTROLLVARIABLEN ---
  age                   Int?
  gender                String?
  education             String?
  techAffinity          Int?
  aiExperience          Int?
  criticalSystemExp     Boolean?

  // Zeitstempel
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ParticipantLead {
  id              String   @id @default(cuid())
  email           String   @unique
  wantsRaffle     Boolean  @default(false)
  wantsNewsletter Boolean  @default(false)
  createdAt       DateTime @default(now())
}