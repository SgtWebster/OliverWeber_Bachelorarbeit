// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ParticipantSession {
  id              String   @id @default(uuid())
  group           String
  currentPhase    String   @default("INIT")

  // --- TECHNISCHE ERHEBUNGSMETADATEN ---
  deviceType      String?
  osGroup         String?

  // --- ABHÄNGIGE VARIABLEN ---
  // Phase 1: Soziale Adhärenz (H3) - Summenscore
  socialAdherence Int?

  // Phase 3: Verhaltens-Compliance (H1) - Binär (0 = Override, 1 = Befolgt)
  compliance      Int?

  // --- MDMT v2 Full Scale (20 Items) ---
  mdmtReliable     Int?
  mdmtPredictable  Int?
  mdmtDependable   Int?
  mdmtConsistent   Int?

  mdmtCompetent    Int?
  mdmtSkilled      Int?
  mdmtCapable      Int?
  mdmtMeticulous   Int?

  mdmtEthical      Int?
  mdmtPrincipled   Int?
  mdmtMoral        Int?
  mdmtHasIntegrity Int?

  mdmtTruthful     Int?
  mdmtGenuine      Int?
  mdmtSincere      Int?
  mdmtFrank        Int?

  mdmtBenevolent   Int?
  mdmtKind         Int?
  mdmtConsiderate  Int?
  mdmtHasGoodwill  Int?

  // --- MDMT v2 Subscale and Factor Scores ---
  reliableTrust    Float?
  competentTrust   Float?
  ethicalTrust     Float?
  sincereTrust     Float?
  benevolentTrust  Float?
  performanceTrust Float?
  moralTrust       Float?
  totalTrust       Float?

  // --- MANIPULATION CHECK ---
  perceivedHumanlikeness  Int?
  perceivedSocialPresence Int?

  // --- SZENARIO- UND ENTSCHEIDUNGSBEWERTUNG ---
  scenarioSeriousness Int?
  consequenceClarity  Int?
  shutdownPreference  Int?
  feltResponsibility  Int?

  // --- DEMOGRAPHIE & KONTROLLVARIABLEN ---
  age                   Int?
  gender                String?
  education             String?
  techAffinity          Int?
  aiExperience          Int?
  simulationExperience  Int?
  criticalSystemExp     Boolean?

  // Zeitstempel
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ParticipantLead {
  id              String   @id @default(cuid())
  email           String   @unique
  wantsRaffle     Boolean  @default(false)
  wantsNewsletter Boolean  @default(false)
  createdAt       DateTime @default(now())
}
